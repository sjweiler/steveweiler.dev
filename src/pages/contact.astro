---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Steve Weiler"
  description="Contact Steve Weiler about software development, Linux, infrastructure, AI, or consulting opportunities."
>
<main>

    <section class="page-header">
        <h1>Contact</h1>
        <p>
            Feel free to reach out regarding software development,
            Linux, infrastructure, AI, or consulting opportunities.
        </p>
    </section>

    <section class="contact-grid">
        <article class="card contact-card contact-card--primary">
            <p class="eyebrow">Best first step</p>
            <h2>Send a direct email</h2>
            <p>
                For project inquiries, consulting conversations, or collaboration ideas,
                email is the fastest way to reach me.
            </p>

            <a class="button" href="mailto:steve@steveweiler.dev">
                steve@steveweiler.dev
            </a>
        </article>

        <article class="card contact-card">
            <p class="eyebrow">Profiles</p>
            <h2>Find me elsewhere</h2>

            <div class="contact-links">
                <a href="https://github.com/sjweiler" target="_blank" rel="noreferrer">
                    <span class="contact-label">GitHub</span>
                    <span>github.com/sjweiler</span>
                </a>
                <a href="https://linkedin.com/in/steve-weiler-0424031a" target="_blank" rel="noreferrer">
                    <span class="contact-label">LinkedIn</span>
                    <span>linkedin.com/in/steve-weiler-0424031a</span>
                </a>
            </div>
        </article>

        <article class="card contact-card">
            <p class="eyebrow">Good fit</p>
            <h2>What to contact me about</h2>

            <ul class="feature-list">
                <li>Systems administration and infrastructure projects</li>
                <li>Automation, internal tooling, and productized scripts</li>
                <li>Desktop software, Linux, and AI-integrated workflows</li>
            </ul>
        </article>
    </section>

    <section class="card cta-strip">
        <div>
            <p class="eyebrow">Fast response</p>
            <h2>If you already have a brief, send it.</h2>
            <p>
                A short description of the problem, timeline, and environment is enough to start.
            </p>
        </div>
        <a class="button secondary" href="/resume/">Review resumes</a>
    </section>

</main>
</BaseLayout>
